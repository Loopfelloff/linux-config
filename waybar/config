{
    "layer": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "hyprland/workspaces",
        "custom/audio"
    ],
    "modules-center": [],
    "modules-right": [
        "group/system"
    ],

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "network",
            "cpu",
            "memory",
            "backlight",
            "battery",
            "clock"
        ]
    },

    "hyprland/workspaces": {
        "format": "{id} {windows}",
        "format-window-separator": " ",
        "on-click": "activate",
        "window-rewrite-default": "\uf2d0",
        "window-rewrite": {
            "class<kitty>": "\uf120",
            "class<[Aa]lacritty>": "\uf120",
            "class<[Ff]irefox>": "\uf269",
            "class<[Ff]irefox> title<.*[Yy]ou[Tt]ube.*>": "\uf167",
            "class<[Cc]hromium>": "\uf268",
            "class<[Gg]oogle-chrome>": "\uf268",
            "class<[Bb]rave-browser>": "\uf268",
            "class<[Cc]ode>": "\ue70c",
            "class<[Cc]ode-oss>": "\ue70c",
            "class<[Dd]iscord>": "\uf392",
            "class<[Vv]esktop>": "\uf392",
            "class<org.telegram.desktop>": "\uf2c6",
            "class<[Ss]potify>": "\uf1bc",
            "class<[Ss]team>": "\uf1b6",
            "class<[Tt]hunar>": "\uf07b",
            "class<org.gnome.Nautilus>": "\uf07b",
            "class<[Pp]cmanfm>": "\uf07b",
            "class<mpv>": "\uf03d",
            "class<vlc>": "\uf03d",
            "class<org.pwmt.zathura>": "\uf1c1",
            "class<[Pp]avucontrol>": "\uf028",
            "class<[Oo]bsidian>": "\uf02d",
            "class<[Ss]lack>": "\uf198",
            "class<[Gg]imp.*>": "\uf03e",
            "class<[Ee]og>": "\uf03e"
        }
    },

    // Shows which workspaces currently have audio playing
    "custom/audio": {
        "exec": "$HOME/.config/waybar/scripts/audio-workspaces.py",
        "return-type": "json",
        "interval": 2
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "MEM {}%"
    },

    "backlight": {
        "format": "BRT {percent}%"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-full": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-plugged": "BAT {capacity}% AC",
        "tooltip": false
    },

    "network": {
        "format-wifi": "NET {signalStrength}%",
        "format-ethernet": "NET {ipaddr}/{cidr}",
        "format-linked": "NET {ifname} (NO IP)",
        "format-disconnected": "NET OFFLINE",
        "tooltip-format": "{essid}"
    },

    "pulseaudio": {
        "format": "VOL {volume}%  {format_source}",
        "format-bluetooth": "BT {volume}%  {format_source}",
        "format-bluetooth-muted": "BT MUTE  {format_source}",
        "format-muted": "VOL MUTE  {format_source}",
        "format-source": "MIC {volume}%",
        "format-source-muted": "MIC OFF",
        "on-click": "pavucontrol"
    }
}
