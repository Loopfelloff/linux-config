/* ===============================
   TACTICAL THEME - BLACK (ROFI)
================================ */

* {
    bg:        #000000;
    bg-hover:  #0d0d0d;
    line:      #2a2a24;
    amber:     #e0a526;
    orange:    #e8762c;
    cream:     #efe4c4;
    dim:       #6f6c5c;
    olive:     #8a9a4b;
    teal:      #5aa9a0;
    red:       #d9473f;

    font: "JetBrainsMono Nerd Font Bold 14";
}

/* ===============================
   Window
================================ */

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    height: 600px;
    border: 2px;
    border-radius: 0px;
    border-color: @line;
    background-color: @bg;
}

mainbox {
    background-color: @bg;
    children: [ horibox ];
    spacing: 0px;
    padding: 0px;
}

horibox {
    background-color: transparent;
    children: [ image-container, vertbox ];
    orientation: horizontal;
    spacing: 0px;
}

/* ===============================
   Left side - image
================================ */

image-container {
    background-image: url("~/non_programming/images/wall.jpg", width);
    border: 0px 2px 0px 0px;
    border-color: @amber;
    border-radius: 0px;
    padding: 0px;
}

/* ===============================
   Right side - search
================================ */

vertbox {
    background-color: @bg;
    children: [ inputbar, listview, mode-switcher ];
    spacing: 10px;
    padding: 10px;
    expand: true;
}

inputbar {
    background-color: @bg-hover;
    text-color: @cream;
    border: 0px 0px 0px 3px;
    border-color: @amber;
    border-radius: 0px;
    padding: 10px;
    children: [ entry ];
}

prompt {
    background-color: transparent;
    text-color: @amber;
    padding: 0px 10px 0px 0px;
}

entry {
    background-color: transparent;
    text-color: @cream;
    placeholder: "Search...";
    placeholder-color: @dim;
}

/* ===============================
   List
================================ */

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    background-color: transparent;
    text-color: @dim;
    orientation: horizontal;
    border: 0px 0px 0px 3px;
    border-color: transparent;
    border-radius: 0px;
    padding: 8px;
}

element-icon {
    background-color: transparent;
    size: 32px;
    padding: 0px 10px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal {
    text-color: @cream;
}

element selected {
    background-color: @bg-hover;
    text-color: @amber;
    border-color: @amber;
}

/* ===============================
   States
================================ */

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @red;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @olive;
}

element selected.urgent {
    background-color: @red;
    text-color: @bg;
    border-color: @red;
}

element selected.active {
    background-color: @olive;
    text-color: @bg;
    border-color: @olive;
}

/* ===============================
   Mode switcher
================================ */

mode-switcher {
    background-color: @bg;
    border: 1px;
    border-color: @line;
    border-radius: 0px;
    padding: 4px;
}

button {
    background-color: transparent;
    text-color: @dim;
    padding: 8px;
    border: 0px 0px 2px 0px;
    border-color: transparent;
    border-radius: 0px;
}

button selected {
    background-color: @bg;
    text-color: @amber;
    border-color: @amber;
}
